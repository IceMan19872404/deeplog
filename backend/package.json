{
  "name": "deeplog-backend",
  "version": "0.1.0",
  "description": "DeepLog 2.0 backend",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed:demo": "node scripts/seed-demo-dives.js",
    "check": "find src tests scripts -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js tests/e2e/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.js",
    "audit:ci": "npm audit --audit-level=moderate",
    "photos:strip-metadata": "node scripts/strip-photo-metadata.js"
  },
  "dependencies": {
    "@sentry/node": "^10.75.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.13.3",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.1.1"
  },
  "overrides": {
    "minimatch": "^11.0.9"
  }
}
